# Copia este archivo como .env (no lo subas a git) y completa los valores.
# Dominio público (debe apuntar a la IP del servidor), sin https://
DOMAIN=app.tudominio.com
# Contraseña de la base de datos (larga y aleatoria)
DB_PASSWORD=
# Secreto de las sesiones: 32+ caracteres aleatorios (p. ej. openssl rand -base64 48)
JWT_SECRET=
# Correo saliente (recuperar contraseña, avisos). Opcional.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-responder@tudominio.com
# Asistente IA (Claude). Opcional: sin clave funcionan las consultas rápidas.
ANTHROPIC_API_KEY=
# App de Play Store (TWA): paquete y huella SHA-256 del certificado de firma (ver docs/PLAY_STORE.md)
APP_ANDROID_PACKAGE=com.tiendaposs.app
APP_ANDROID_SHA256=
